{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "esModuleInterop": true
  },
  "include": [
    "index.ts",
    "config.cjs",
    "image-generation.cjs",
    "pi-runtime.cjs",
    "transport.cjs"
  ]
}
